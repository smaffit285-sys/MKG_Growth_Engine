# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your Apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Configuration
VITE_APP_URL=https://your-app-url.web.app

# Tenant branding (safe to expose in the browser bundle)
VITE_BRAND_BUSINESS_NAME=Your Sharpening Company
VITE_BRAND_SHORTHAND=YSC
VITE_BRAND_OWNER_NAME=Owner Name
VITE_BRAND_PHONE_DISPLAY=305-555-0100
VITE_BRAND_PHONE_E164=+13055550100
VITE_BRAND_WEBSITE=www.example.com
VITE_BRAND_WEBSITE_URL=https://www.example.com
VITE_BRAND_EMAIL=hello@example.com
VITE_BRAND_TAGLINE=Professional sharpening, made simple
VITE_BRAND_SOCIAL_HANDLE=@YourSharpeningCompany
VITE_BRAND_REVIEW_REQUEST=If the service earned it, an honest review is always appreciated.

# Optional: Firebase Measurement ID (for Analytics)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only Vercel function configuration (never expose with a VITE_ prefix)
# Google Cloud access uses Vercel OIDC and short-lived tokens, not a private key.
GCP_PROJECT_ID=project-1e3d5afa-9ec2-492e-b71
GCP_PROJECT_NUMBER=329238909950
GCP_SERVICE_ACCOUNT_EMAIL=vercel-crm-intake@project-1e3d5afa-9ec2-492e-b71.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Trusted public website identity for /api/website-intake
VERCEL_OIDC_SCOPE=your-vercel-team-slug
VERCEL_OIDC_OWNER_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx
WEBSITE_VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxx
WEBSITE_VERCEL_ENVIRONMENTS=preview,production

# Lead notification email (server only; never use a VITE_ prefix)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_EMAIL_DOMAIN=example.com
LEAD_NOTIFICATION_FROM=Your Company Website <bookings@example.com>
LEAD_NOTIFICATION_TO=owner@example.com
LEAD_NOTIFICATION_BACKUP_TO=backup1@example.com,backup2@example.com
LEAD_NOTIFICATION_SERVICE_COPY_TO=backup1@example.com

# Firebase Functions tenant configuration
BUSINESS_NAME=Your Sharpening Company
BUSINESS_SHORTHAND=YSC
OWNER_NAME=Owner Name
OWNER_PHONE=+13055550100
OWNER_PHONE_DISPLAY=(305) 555-0100
PUBLIC_WEBSITE_URL=https://www.example.com
