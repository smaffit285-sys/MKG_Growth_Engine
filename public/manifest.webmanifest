      "purpose": "any maskable"
    },
    {
      "src": "/growth-engine-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/growth-engine-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Consumer quote or service",
      "short_name": "Consumer",
      "url": "/field?path=consumer",
      "description": "Start a residential or individual customer quote or service."
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "description": "Open the MKG command dashboard."
    },
    {
      "name": "Commercial accounts",
      "short_name": "Commercial",
      "url": "/commercial",
      "description": "Open commercial quotes and recurring accounts."
    },
    {
      "name": "Product catalogue",
      "short_name": "Catalogue",
      "url": "/catalog",
      "description": "Open the configured service and product catalogue."
    }
  ]
